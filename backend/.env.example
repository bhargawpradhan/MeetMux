# MeetMux Control Tower — Backend Environment Configuration
# Copy to backend/.env and fill in your values

# ─── Neo4j (optional — falls back to NetworkX if not set) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Optional LLM (Copilot enhanced mode) ────────────────────────────────────
# App works in rule-based mode without this key
# LLM_API_KEY=your-gemini-or-openai-key
